// Vazirmatn (OFL) is one family covering Latin, Arabic and the Greek, Russian, Ukrainian and
// Vietnamese alphabets with consistent metrics, so mixed-script rows don't drift vertically the
// way they do across a fallback. These TTFs are BUILT: `scripts/patch_vazirmatn.py` merges in
// those four alphabets' letters from Roboto, then rewrites the OS/2 typo + hhea metrics to a
// Latin-typical line ratio, upstream's ~1.56× (which fits Arabic combining marks) pushing every
// centred Latin text several px up at our sizes. Pristine copies of both live in
// `assets/fonts/originals/` as the script's input.
import "assets/fonts/vazirmatn/Vazirmatn-Regular.ttf";
import "assets/fonts/vazirmatn/Vazirmatn-Medium.ttf";
import "assets/fonts/vazirmatn/Vazirmatn-SemiBold.ttf";
// A dedicated Simplified Chinese face keeps Han text independent of host font fallback.
import "assets/fonts/NotoSansSC-VF.ttf";

import { Theme } from "theme.slint";
import { CloudAccount, Settings } from "settings.slint";
import { Albums, AlbumDetail } from "globals/albums.slint";
import { Artists, ArtistDetail } from "globals/artists.slint";
import { Equalizer, ReplayGain, Visualizer } from "globals/audio.slint";
import { Favorites, RecentlyPlayed } from "globals/curated.slint";
import { SmartEditor, TagEditor } from "globals/dialog-forms.slint";
import { Dialog, DialogKind } from "globals/dialog.slint";
import { Genres, GenreDetail } from "globals/genres.slint";
import { HeroBackdrop } from "globals/hero-backdrop.slint";
import { HeroChips } from "globals/hero-chips.slint";
import { LibrarySettings, ScanPhase } from "globals/library-settings.slint";
import { MyLibrary } from "globals/my-library.slint";
import { Lyrics, LyricsState } from "globals/lyrics.slint";
import { Nav, NavEnterFrom } from "globals/nav.slint";
import { Onboarding } from "globals/onboarding.slint";
import { Player } from "globals/player.slint";
import { Playlists, PlaylistDetail, PlaylistPlaybackAction } from "globals/playlists.slint";
import { CardSelection } from "globals/card-selection.slint";
import { Selection } from "globals/selection.slint";
import { CardActions } from "globals/card-actions.slint";
import { CopyActions } from "globals/copy-actions.slint";
import { ArtistChoice, ArtistPicker } from "globals/artist-picker.slint";
import { CloudTrackActions } from "globals/cloud-track-actions.slint";
import { CloudEntityDetail } from "globals/cloud-entity-detail.slint";
import { Queue, NowPlaying } from "globals/queue.slint";
import { Search } from "globals/search.slint";
import { SettingsPage } from "globals/settings-page.slint";
import { DragRegion, WindowChrome, MiniPlayer, CompositeScroll, PopupHighlight } from "globals/shell.slint";
import { SignalPathUi } from "globals/signal-path.slint";
import { Tracks, Browse, RowCovers } from "globals/tracks.slint";
import { TrackColumnSizing } from "globals/track-columns.slint";
import { NetodiaUpdater } from "globals/updater.slint";
import { Notifications } from "globals/notifications.slint";
import { Wrap } from "globals/wrap.slint";
import { TrackSummaryRow, TrackListRow, PlayerVm, QueueVm, QueueRow, FolderListRow,
         BrowseFolderRow, BreadcrumbRow, NotificationRow, TrackMetaRow,
         AlbumRow, AlbumGridRow, ArtistRow, ArtistGridRow,
         GenreRow, GenreGridRow,
         PlaylistRow, PlaylistGridRow, SmartRuleRow, LyricRow,
         TrackColumns, TrackColumnLayout, TrackColumn } from "models.slint";
import { Sidebar } from "layout/sidebar.slint";
import { NowPlayingBar } from "layout/now-playing-bar.slint";
import { ResizeRing } from "layout/resize-ring.slint";
import { ShortcutScope } from "layout/shortcut-scope.slint";
import { PlaceholderView } from "views/placeholder-view.slint";
import { MyLibraryView } from "views/my-library-view.slint";
import { FavoritesView } from "views/favorites-view.slint";
import { CloudEntityDetailView } from "views/favorites/cloud-entity-detail-view.slint";
import { RecentlyPlayedView } from "views/recently-played-view.slint";
import { BrowseView } from "views/browse-view.slint";
import { SearchView } from "views/search-view.slint";
import { SettingsView } from "views/settings-view.slint";
import { NowPlayingView } from "views/now-playing-view.slint";
import { MiniPlayerView } from "views/mini-player.slint";
import { QueueSheet } from "views/queue-sheet.slint";
import { DialogOverlay } from "components/dialog/dialog.slint";
import { OnboardingOverlay } from "components/onboarding/onboarding-overlay.slint";
import { CustomTitleBar } from "components/custom-titlebar.slint";
import { EdgeOutline } from "components/edge-outline.slint";
import { RoundedFrame } from "components/rounded-frame.slint";
import { NotificationStack } from "components/dialog/notification-stack.slint";
import { MiniPlayerSwitch } from "components/mini-player-switch.slint";
import { SectionActiveGate } from "components/section-active-gate.slint";
import { Tooltip, TooltipSide } from "components/tooltip.slint";
import { ViewTransition } from "components/view-transition.slint";

// Re-export so Rust can mention these from `slint::include_modules!`.
export {
    ArtistChoice, ArtistPicker,
    CloudTrackActions,
    CloudEntityDetail,
    Theme, Settings, CloudAccount, SettingsPage, Player, HeroBackdrop, HeroChips, Equalizer, ReplayGain, Visualizer, SignalPathUi, SmartEditor, TagEditor, Nav, CompositeScroll, MiniPlayer, MyLibrary, Tracks, Browse, LibrarySettings, Dialog, WindowChrome, Queue, Notifications, NowPlaying, Favorites, RecentlyPlayed, Albums, AlbumDetail, Artists, ArtistDetail, Genres, GenreDetail, Playlists, PlaylistDetail, PopupHighlight, Search, NetodiaUpdater, RowCovers, Onboarding, Lyrics, Wrap, TrackColumnSizing, CardSelection, CardActions, CopyActions, Selection,
    TrackSummaryRow, TrackListRow, PlayerVm, QueueVm, QueueRow, FolderListRow, LyricRow,
    TrackColumns, TrackColumnLayout, TrackColumn,
    BrowseFolderRow, BreadcrumbRow, NotificationRow, TrackMetaRow,
    AlbumRow, AlbumGridRow, ArtistRow, ArtistGridRow,
    GenreRow, GenreGridRow,
    PlaylistRow, PlaylistGridRow, SmartRuleRow, PlaylistPlaybackAction,
}

export component AppWindow inherits Window {
    title: "Netodia";
    // No `preferred-width`/`-height` on purpose: `window_chrome/geometry.rs::restore` calls
    // `set_size` after `AppWindow::new()`, setting winit's `has_explicit_size` — the only thing
    // stopping Slint snapping to the content-preferred size on first show, which a preferred size
    // here would be the target of. The floor is the miniplayer's smallest sensible footprint, so
    // the user can drag straight into mini mode.
    //
    // **Under an OS frame it gives up the frame's size.** Win32 reads the minimum once, at the start
    // of a resize drag, and adds the frame to it; the miniplayer drops that frame mid-drag, so a
    // drag begun in the full UI held it that much above the floor until the button came up. Framed,
    // the window only sits under the true floor for the swap's fade.
    min-width: MiniPlayer.window-min-width - (root.frameless ? 0px : WindowChrome.frame-allowance-w);
    min-height: MiniPlayer.window-min-height - (root.frameless ? 0px : WindowChrome.frame-allowance-h);
    // The custom titlebar never has an OS frame, and the native one drops it for the miniplayer,
    // which carries its own drag region. On `render-active`, so the frame changes on the tick the
    // branches swap, with the outgoing one faded out and the crossfade still opaque. Any earlier, the
    // full UI fades out with no titlebar at all or the miniplayer fades out under the OS one, and on
    // Win32 the visible window steps in or out by the invisible resize borders while it's on screen.
    property <bool> frameless: !Theme.use-native-titlebar || mini-switch.render-active;
    // This binding is what drives `no-frame`, so it is the only announcement Rust gets that the OS
    // is about to move the client by a frame. It runs a change-handler pass ahead of the window
    // property being applied, which is the whole of the headroom the reading is allowed.
    changed frameless => {
        WindowChrome.frame-changed();
    }
    // The one shape that draws its own window edge: rounded corners, the outline and the resize
    // grabs. Maximized, the corners would clip against the screen edge and resizing is a no-op.
    property <bool> rounded-shell: root.frameless && !WindowChrome.is-maximized;

    // The rounded shell gets a transparent ARGB surface, so the compositor blends the mantle with
    // the desktop and the alpha=0 corners read as "not our window". A native frame or maximized goes
    // opaque: native wants the OS frame to abut a solid backdrop.
    background: root.rounded-shell ? Colors.transparent : Theme.mantle;

    // What the native miniplayer leaves transparent around itself: the invisible borders the frame
    // it dropped kept outside its visible edges, which the client takes over when the frame goes. Left
    // painted, the window grows by them on every swap in and shrinks by them on every swap out.
    // Zero off Win32, where Rust writes none.
    property <bool> keeps-frame-margins: Theme.use-native-titlebar && root.rounded-shell;
    property <length> margin-left: root.keeps-frame-margins ? WindowChrome.frame-margin-left : 0px;
    property <length> margin-right: root.keeps-frame-margins ? WindowChrome.frame-margin-right : 0px;
    property <length> margin-bottom: root.keeps-frame-margins ? WindowChrome.frame-margin-bottom : 0px;
    // The rect the shell and everything over it occupies inside the client.
    property <length> content-width: root.width - root.margin-left - root.margin-right;
    property <length> content-height: root.height - root.margin-bottom;

    // What every tooltip keeps its pill inside.
    function publish-shell-rect() {
        WindowChrome.shell-x = root.margin-left;
        WindowChrome.shell-width = root.content-width;
        WindowChrome.shell-height = root.content-height;
    }
    changed margin-left => { root.publish-shell-rect(); }
    changed content-width => { root.publish-shell-rect(); }
    changed content-height => { root.publish-shell-rect(); }
    // `changed` doesn't fire when the first layout settles directly on the final size.
    Timer {
        interval: 1ms;
        triggered => {
            root.publish-shell-rect();
            self.running = false;
        }
    }

    // `window_chrome::install` hydrates `Theme.use-native-titlebar` before `app.show()`, so the
    // window maps with the right frame; Slint applies later flips live. Dropping the OS frame also
    // drops its resize edges, which `ResizeRing` restores along this band, as wide as the margins it
    // covers so they resize the way the frame's borders did.
    //
    // No `resize-border-width`: Slint's handler for it hit-tests square corners a band wide, against
    // a logical width compared with a physical cursor, so it took presses the ring's cursor said
    // meant something else.
    property <length> resize-band: max(Theme.resize-border, root.margin-left, root.margin-right,
        root.margin-bottom);
    no-frame: root.frameless;

    default-font-family: Settings.locale-code == "zh_CN" ? "Noto Sans SC" : "Vazirmatn";
    default-font-size: Theme.font-size-md;

    function view-title(idx: int) -> string {
        if (idx == 0) { return @tr("Search"); }
        if (idx == 1) { return @tr("Browse"); }
        if (idx == 2) { return @tr("Favorites"); }
        // 4–7 were Albums / Artists / Genres / Playlists; they are tabs of this page now.
        if (idx == 3) { return @tr("My Library"); }
        if (idx == 8) { return @tr("Recently Played"); }
        if (idx == 9) { return @tr("Settings"); }
        // App name (proper noun) — never translated.
        return "Netodia";
    }

    // Up here because `SettingsView` is unmounted before a handler inside it could see the leaving
    // transition, and on a mirror because `changed` rejects path expressions on globals.
    property <int> watched-nav-idx: Nav.selected-index;
    changed watched-nav-idx => {
        CompositeScroll.reset();
        if (self.watched-nav-idx != 9) {
            SettingsPage.clear-search();
        }
        // My Library's band holds its hero across a tab leave, so a *nav* change is the only thing
        // that can hand it back — and a `SectionActiveGate` cannot see this edge: the sidebar
        // clears `now-playing-open` and writes the index in one handler, so a gate already false
        // behind Now Playing goes false → false.
        MyLibrary.page-active-changed(self.watched-nav-idx == 3);
        // The outgoing view may hold focus in a TextInput about to be destroyed, and Slint doesn't
        // hand focus back to an ancestor FocusScope. Synchronous, so SearchView's autofocus wins.
        shortcut-scope.grab-focus();
    }

    // QR polling belongs to the account card's page. Leaving Settings, opening Now Playing, or
    // switching away from Services ends it even though `CloudAccount` outlives the view itself.
    property <bool> watched-qr-login-page-active:
        self.watched-nav-idx == 9 && !Nav.now-playing-open
        && (SettingsPage.tab-idx == SettingsPage.tab-services
            || SettingsPage.search-query != "");
    changed watched-qr-login-page-active => {
        CloudAccount.qr-page-active-changed(self.watched-qr-login-page-active);
    }

    // A My Library tab pick swaps the mounted body without moving `Nav.selected-index`, so the
    // mirror above never sees it. Artist Detail is one of the bodies it unmounts and it is
    // composite, so this owes the reset as well as the regrab.
    property <int> watched-my-library-tab: MyLibrary.tab-idx;
    changed watched-my-library-tab => {
        CompositeScroll.reset();
        shortcut-scope.grab-focus();
    }

    // Lets Rust gate the Up Next rebuild on the view being visible. Mirrored here for the
    // `watched-nav-idx` reasons — `NowPlayingView` is unmounted while closed.
    property <bool> watched-now-playing-open: Nav.now-playing-open;
    changed watched-now-playing-open => {
        // NP open/close swaps the mounted content view, and destroys the section view
        // under it — same focus orphaning as a sidebar nav.
        CompositeScroll.reset();
        Nav.now-playing-open-changed(self.watched-now-playing-open);
        shortcut-scope.grab-focus();
    }

    // Arms the visualizer's audio-thread sample tap only while something is drawing it. Its own
    // property rather than a second handler on `now-playing-open-changed`, whose one slot is
    // already taken by `wire_now_playing_open`.
    property <bool> watched-viz-active: Nav.now-playing-open && Visualizer.enabled;
    changed watched-viz-active => {
        Visualizer.set-active(self.watched-viz-active);
    }

    // Artist Detail is a composite-scroll view that opens and closes without a nav-index change, so
    // the reset above misses it and the unmounting view's stale hover flag would trap the wheel.
    property <int> watched-artist-detail-id: ArtistDetail.artist-id;
    changed watched-artist-detail-id => {
        CompositeScroll.reset();
        shortcut-scope.grab-focus();
    }

    // The other three unmount their grid the same way, and every grid carries a filter TextInput
    // still holding focus when a card is clicked. None is composite, so focus is all they owe.
    property <int> watched-album-detail-id: AlbumDetail.album-id;
    changed watched-album-detail-id => {
        shortcut-scope.grab-focus();
    }

    property <int> watched-genre-detail-id: GenreDetail.genre-id;
    changed watched-genre-detail-id => {
        shortcut-scope.grab-focus();
    }

    property <int> watched-playlist-detail-id: PlaylistDetail.playlist-id;
    changed watched-playlist-detail-id => {
        shortcut-scope.grab-focus();
    }

    // The miniplayer swap unmounts the whole full-UI branch — composite views and focused filters
    // with it — without a nav-index change, so the resets above miss it too.
    property <bool> watched-mini-render: mini-switch.render-active;
    changed watched-mini-render => {
        CompositeScroll.reset();
        // Same class of stale sentinel one global over: the rail dies with the branch and its rows
        // get no leave event, so the tooltip frame reads the last index as a live hover on return.
        Nav.sidebar-tip-idx = -1;
        // And the drag regions' hover, which the winit filter reads on every left press. Both the
        // titlebar's and the miniplayer's die with their branch, and one unmounted under the
        // pointer never reports it gone: the miniplayer's restore resizes the window under a still
        // pointer and swaps, leaving every press in either layout a window drag.
        WindowChrome.drag-region-changed(DragRegion.none);
        shortcut-scope.grab-focus();
    }

    // Every dialog body mounts under an `if` on `Dialog.kind` and `closed-teardown()` clears it,
    // so a focused LabeledInput dies with the body as a filter does above. Ungated on purpose: the
    // bodies never autofocus, so regrabbing on *open* takes the keyboard off whatever SearchBar
    // held it. Safe where `focus()` from `init` isn't — a `changed` handler runs from
    // `run_change_handlers`, outside the property evaluator's recursion guard.
    property <DialogKind> watched-dialog-kind: Dialog.kind;
    changed watched-dialog-kind => {
        shortcut-scope.grab-focus();
    }

    // The sheet is the odd one out: permanent, mounting nothing, only animating in. But its Esc /
    // Ctrl+A live in the scope and nothing moves focus when it opens — the bar button and the
    // overflow entry are both TouchArea clicks — so a filter SearchBar swallows the `a`.
    property <bool> watched-queue-open: Queue.open;
    changed watched-queue-open => {
        shortcut-scope.grab-focus();
    }

    // The welcome card's buttons can hold focus, and Slint doesn't hand it back to an ancestor
    // scope when the focused item is destroyed — so without this the shortcuts stay dead after it
    // closes, until the next click. It mounts no composite view, so it owes no `CompositeScroll`
    // reset beside this.
    property <bool> watched-onboarding-mounted: Onboarding.mounted;
    changed watched-onboarding-mounted => {
        shortcut-scope.grab-focus();
    }

    // The responsive full-UI ↔ miniplayer swap: size thresholds, the two-phase fade, and the writes
    // into `MiniPlayer`. Fed the live window size, a component's root binding having no `parent`.
    mini-switch := MiniPlayerSwitch {
        host-width: root.width;
        host-height: root.height;
        view-width: root.content-width;
        view-height: root.content-height;
        exit-allowance-w: WindowChrome.frame-allowance-w;
        exit-allowance-h: WindowChrome.frame-allowance-h;
    }

    // Here because Rust reaches only the root's functions. `geometry::restore` calls it once the
    // restored size is in, before the window maps.
    public function adopt-restored-size() {
        mini-switch.adopt-restored-size();
    }

    // What that mounted, read back by `geometry::restore` and here for the same reason.
    public pure function miniplayer-mounted() -> bool {
        return mini-switch.render-active;
    }

    // The winit filter's word on where a resize begins and where it is let go, which only it can
    // tell.
    public function resize-began() {
        mini-switch.resize-began();
    }
    public function resize-released() {
        mini-switch.resize-released();
    }

    // **The clipboard, and the whole of it.** Slint's `TextInput` reaches the platform clipboard
    // the windowing backend owns, which on Wayland speaks over the app's own display connection; a
    // clipboard crate of our own would land on XWayland there. Disabled so a Tab walk can't put
    // focus on it, which neither `select-all` nor `copy` asks about. Pinned at the origin, a child
    // with no `x`/`y` here being centred.
    clipboard-sink := TextInput {
        x: 0px;
        y: 0px;
        width: 0px;
        height: 0px;
        enabled: false;
    }

    // `ui::clipboard::write` is the one caller. The text is dropped again once copied, so a stream
    // URL, which can carry a session token, doesn't sit in the tree afterwards.
    public function copy-to-clipboard(text: string) {
        clipboard-sink.text = text;
        clipboard-sink.select-all();
        clipboard-sink.copy();
        clipboard-sink.text = "";
    }

    // One gate per section in nav-index order, plus one per tab for a section built out of tabs.
    // `SectionActiveGate` owns the predicate and the `changed` watcher; all that differs per mount
    // is which Rust hook it drives, which is what the notes below record.

    // Search. Query-driven, so no library-changed refresh, but Rust still releases the
    // per-strip album + artist cover LRUs on `false`. `query` + `recent-rows` survive a flip.
    SectionActiveGate {
        index: 0;
        mini-active: mini-switch.active;
        active-changed(active) => { Search.section-active-changed(active); }
    }

    // Browse. Gate-only, like Tracks: the `library_changed` subscriber skips
    // re-fetching the current directory while the view is hidden.
    SectionActiveGate {
        index: 1;
        mini-active: mini-switch.active;
        active-changed(active) => { Browse.section-active-changed(active); }
    }

    // Favorites. One `FavoritesView` covers the hero and all three tabs, so no detail flip inside
    // this branch. Rust releases the mosaic / Most Played / Artists cover caches *and* the borrowed
    // Albums grid cache on `false`, then re-fetches through the library-changed dirty flag.
    SectionActiveGate {
        index: 2;
        mini-active: mini-switch.active;
        active-changed(active) => { Favorites.section-active-changed(active); }
    }

    // My Library. Five gates on one index, one per tab. **A tab leave has to be the same event as a
    // section leave**, tearing the same models down and re-fetching the same way, so each keeps the
    // hook it had as a sidebar section and `tab-index` / `current-tab` supplies the second half of
    // the predicate. A drill-in doesn't move `tab-idx`. **The page's own teardown is not a sixth
    // gate** and can't be — it fires when the *nav index* leaves 3, which a gate already false
    // behind Now Playing never reports; it rides `changed watched-nav-idx` above.

    // Songs. Unlike the four grids the view keeps its row model warm across leaves, so this
    // only gates the `library_changed` refresher.
    SectionActiveGate {
        index: 3;
        tab-index: MyLibrary.tab-songs;
        current-tab: MyLibrary.tab-idx;
        mini-active: mini-switch.active;
        active-changed(active) => { Tracks.section-active-changed(active); }
    }

    // Albums. Rust shrinks the shared grid tier to proxies on `false` (tab away, nav away, or
    // opening Now Playing *from* the tab) and re-warms on `true`.
    SectionActiveGate {
        index: 3;
        tab-index: MyLibrary.tab-albums;
        current-tab: MyLibrary.tab-idx;
        mini-active: mini-switch.active;
        active-changed(active) => { Albums.section-active-changed(active); }
    }

    // Artists.
    SectionActiveGate {
        index: 3;
        tab-index: MyLibrary.tab-artists;
        current-tab: MyLibrary.tab-idx;
        mini-active: mini-switch.active;
        active-changed(active) => { Artists.section-active-changed(active); }
    }

    // Genres. The hook has no cache to release — genres have no artwork — but stays
    // wired for symmetry with Albums / Artists.
    SectionActiveGate {
        index: 3;
        tab-index: MyLibrary.tab-genres;
        current-tab: MyLibrary.tab-idx;
        mini-active: mini-switch.active;
        active-changed(active) => { Genres.section-active-changed(active); }
    }

    // Playlists. Mirrors the Albums hook over the playlist-tier cover cache.
    SectionActiveGate {
        index: 3;
        tab-index: MyLibrary.tab-playlists;
        current-tab: MyLibrary.tab-idx;
        mini-active: mini-switch.active;
        active-changed(active) => { Playlists.section-active-changed(active); }
    }

    // Recently Played. Like Favorites: release the cover cache on `false`, re-fetch on `true`.
    SectionActiveGate {
        index: 8;
        mini-active: mini-switch.active;
        active-changed(active) => { RecentlyPlayed.section-active-changed(active); }
    }

    // Outer mantle shell. With a transparent Window background this rounded Rectangle *is* the
    // visible window outline, and `clip: true` masks anything a child paints outside it.
    // A native frame or maximized drops the radius to 0 and stays full-bleed; the panel still rounds.
    //
    // **The clip is the only antialiased edge the corner may get.** FemtoVG antialiases every
    // rounded fill and stroke on its own, and partial coverages of one curve stack, so a background
    // on the shell or an outline beside it paints the arc fuller and harder than its radius. Hence
    // no `background` here, and everything that reaches the edge mounts inside.
    Rectangle {
        x: root.margin-left;
        y: 0px;
        width: root.content-width;
        height: root.content-height;
        border-radius: root.rounded-shell ? Theme.window-radius : 0px;
        clip: true;

        Rectangle {
            width: 100%;
            height: 100%;
            background: WindowChrome.mantle;
        }

        // The only FocusScope in the tree, wrapping the whole main layout — every key a focused
        // TextInput doesn't consume lands here directly. Bindings, the volume-commit debounce and
        // the focus contract are in the component.
        shortcut-scope := ShortcutScope {
            width: 100%;
            height: 100%;

        // Full UI branch. Gated on `render-active` — the fade-delayed shadow of `active` — so only
        // one branch is ever mounted, and the sidebar's grid covers never sit alive beside the mini
        // up-next subscriber mid-swap.
        if !mini-switch.render-active: Rectangle {
            width: 100%;
            height: 100%;

            VerticalLayout {
            // `if` rather than `visible: false` so the bar's slot leaves the layout
            // entirely in native mode — a hidden child still claims its stretch.
            // Over the sidebar and the panel, which a caption's tooltip hangs down onto.
            if !Theme.use-native-titlebar: CustomTitleBar { z: 1; }

            // Only the right side needs a gutter: the titlebar, the sidebar and the bar frame the
            // panel's other three. The native titlebar gets one too rather than a flush edge, since
            // the panel rounds all four corners and a flush one would sit against the OS frame.
            HorizontalLayout {
                vertical-stretch: 1;
                padding-right: Theme.pad-xs;

                sidebar := Sidebar {}

                // Content panel. **Rounded by `RoundedFrame`, not by a rounded clip**: that clip
                // would hold the whole view as a texture and render it again on every change inside,
                // so this one has no radius and only keeps a sliding view off the sidebar and the
                // bar. The fill is square; the frame's corner masks round it.
                Rectangle {
                    horizontal-stretch: 1;
                    clip: true;

                    Rectangle {
                        x: 0;
                        y: 0;
                        width: 100%;
                        height: 100%;
                        background: Theme.base;
                    }

                    // One branch per nav index, `if` rather than `visible: false` so the
                    // unselected ones leave the layout tree. Every regular branch is also gated
                    // on `!now-playing-open`, the full-screen view replacing the current one
                    // inside this panel. Unrouted indices fall through to the placeholder.
                    if !Nav.now-playing-open && Nav.selected-index == 0: ViewTransition {
                        width: parent.width;
                        height: parent.height;
                        enter-from: Nav.pending-enter-from;
                        replay-key: "cloud-return:" + CloudEntityDetail.return-tick;
                        replay-slide: false;
                        SearchView { width: 100%; height: 100%; }
                    }
                    if !Nav.now-playing-open && Nav.selected-index == 1: ViewTransition {
                        width: parent.width;
                        height: parent.height;
                        enter-from: Nav.pending-enter-from;
                        replay-key: "cloud-return:" + CloudEntityDetail.return-tick;
                        replay-slide: false;
                        BrowseView { width: 100%; height: 100%; }
                    }
                    // An artist card and the Songs rows' go-to-{album,artist,genre} actions all
                    // stamp `*Detail.origin-nav-index = 2`, so the back arrow returns here.
                    if !Nav.now-playing-open && Nav.selected-index == 2: ViewTransition {
                        width: parent.width;
                        height: parent.height;
                        enter-from: Nav.pending-enter-from;
                        replay-key: "cloud-return:" + CloudEntityDetail.return-tick;
                        replay-slide: false;
                        FavoritesView { width: 100%; height: 100%; }
                    }
                    // Five tabs over what used to be nav 3–7, each tab's grid ↔ detail swap
                    // inside the page — so which body is mounted is `MyLibrary.tab-idx`'s.
                    if !Nav.now-playing-open && Nav.selected-index == 3: ViewTransition {
                        width: parent.width;
                        height: parent.height;
                        enter-from: Nav.pending-enter-from;
                        replay-key: "cloud-return:" + CloudEntityDetail.return-tick;
                        replay-slide: false;
                        MyLibraryView { width: 100%; height: 100%; }
                    }
                    if !Nav.now-playing-open && Nav.selected-index == 8: ViewTransition {
                        width: parent.width;
                        height: parent.height;
                        enter-from: Nav.pending-enter-from;
                        replay-key: "cloud-return:" + CloudEntityDetail.return-tick;
                        replay-slide: false;
                        RecentlyPlayedView { width: 100%; height: 100%; }
                    }
                    if !Nav.now-playing-open && Nav.selected-index == 9: ViewTransition {
                        width: parent.width;
                        height: parent.height;
                        enter-from: Nav.pending-enter-from;
                        replay-key: "cloud-return:" + CloudEntityDetail.return-tick;
                        replay-slide: false;
                        SettingsView { width: 100%; height: 100%; }
                    }
                    if !Nav.now-playing-open
                        && Nav.selected-index != 0
                        && Nav.selected-index != 1
                        && Nav.selected-index != 2
                        && Nav.selected-index != 3
                        && Nav.selected-index != 8
                        && Nav.selected-index != 9
                        : ViewTransition {
                        width: parent.width;
                        height: parent.height;
                        enter-from: Nav.pending-enter-from;
                        replay-key: "cloud-return:" + CloudEntityDetail.return-tick;
                        replay-slide: false;
                        PlaceholderView {
                            width: 100%;
                            height: 100%;
                            title: root.view-title(Nav.selected-index);
                        }
                    }
                    // Hard-coded to `above`: this branch only fires on open, and closing
                    // is the outgoing state, which `ViewTransition` doesn't animate.
                    if Nav.now-playing-open: ViewTransition {
                        width: parent.width;
                        height: parent.height;
                        enter-from: NavEnterFrom.above;
                        NowPlayingView { width: 100%; height: 100%; }
                    }

                    // Cloud album and artist pages sit over whichever view launched them. The
                    // current section stays mounted underneath, so Back returns to its exact scroll
                    // position and filter state.
                    // Keep the controller alive so its shared LibraryTabBand can finish collapsing.
                    // It owns the header morph and the list-only reveal, just like My Library.
                    CloudEntityDetailView {
                        width: 100%;
                        height: 100%;
                    }

                    // Inside the content panel so its backdrop and slide stay off the sidebar
                    // and the bar, after the view branches so it stacks above them. Always
                    // rendered so the close animation can play; the panel's clip hides it.
                    QueueSheet {
                        x: 0;
                        y: 0;
                        width: parent.width;
                        height: parent.height;
                    }

                    // Last, so the corners and the border sit over every view and the sheet. The
                    // shell's ground is all that shows around the panel, so it's the mask colour.
                    // The radius is the one the mantle shell rounds with when frameless:
                    // concentric arcs under the custom titlebar, the host's corners under the
                    // native one.
                    RoundedFrame {
                        x: 0;
                        y: 0;
                        width: 100%;
                        height: 100%;
                        radius: Theme.window-radius;
                        stroke-width: 1px;
                        stroke-color: Theme.border;
                        ground: WindowChrome.mantle;
                    }
                }
            }

            NowPlayingBar {}
            }

            // Top-layer tooltip for the collapsed rail. Declared after the layout because paint
            // order is declaration order: the Sidebar is the content row's first child, so anything
            // it drew past its right edge lands under the panel. The hovered row publishes its rect
            // on `Nav`; the x comes off the live rail, so the frame rides the collapse animation —
            // and the 500 ms reveal outlasts it, so it can't surface while the labels are readable.
            // A plain Rectangle captures no input, so the row underneath keeps its hover.
            sidebar-tip := Rectangle {
                x: sidebar.absolute-position.x - parent.absolute-position.x;
                y: Nav.sidebar-tip-y - parent.absolute-position.y;
                width: sidebar.width;
                height: Nav.sidebar-tip-h;

                // Rail rows sit 4 px apart with a Divider between some pairs, so a pointer
                // travelling down the rail is over nothing for a frame or two and retracting on
                // that restarts the 500 ms reveal per row. Hold across the gap and retract once the
                // pointer has really left; retract leaves the label and rect alone, so the held
                // pill swaps names when the next row takes over. **`held` can only extend a live
                // tooltip; `row-hovered` is what arms one** — `held` is written from a `changed`
                // handler, which doesn't fire on a first evaluation, so a rail remounting under the
                // pointer would sit dead. Reading both also survives an unmount path that forgets
                // the `sidebar-tip-idx = -1` above.
                property <bool> row-hovered: Nav.sidebar-tip-idx != -1;
                property <bool> held;
                changed row-hovered => {
                    if (self.row-hovered) { self.held = true; }
                }
                // Long enough to cross the widest gap — a Divider between sections — at a
                // deliberate pace, short enough that leaving the rail still dismisses.
                Timer {
                    interval: 150ms;
                    running: !sidebar-tip.row-hovered && sidebar-tip.held;
                    triggered => { sidebar-tip.held = false; }
                }

                Tooltip {
                    text: Nav.sidebar-tip-label;
                    hovered: (sidebar-tip.row-hovered || sidebar-tip.held)
                        && Nav.sidebar-collapsed;
                    host-width: sidebar-tip.width;
                    host-height: sidebar-tip.height;
                    side: TooltipSide.right;
                    // Clears the rail rather than hugging it, so the pill reads as part of the
                    // content panel it floats over.
                    gap: Theme.pad-md;
                }
            }
        }

        // Miniplayer branch, inside the scope like the full one.
        if mini-switch.render-active: MiniPlayerView {
            width: 100%;
            height: 100%;
        }

        // The swap's crossfade, painted over whichever branch is mounted rather than spent as
        // `opacity` on it. Both branches sit on the shell's opaque `mantle`, so `mantle` at `1 - t`
        // over a branch is the pixel the branch at `t` over `mantle` was, without rendering the whole
        // UI into a layer for every frame of the fade, or cropping glyph ink to the layer's box.
        Rectangle {
            width: 100%;
            height: 100%;
            background: WindowChrome.mantle.transparentize(mini-switch.fade-opacity);
            visible: mini-switch.fade-opacity < 1.0;
        }
        }

        // The overlays share the shell's clip, so a dialog's backdrop takes the window's rounded
        // corners instead of darkening the desktop behind them, and neither it nor a toast paints
        // into the margins the native miniplayer leaves transparent.

        // The first-run card, and deliberately *below* `DialogOverlay`: step 2's folder picker can
        // raise a real `Dialog` on failure, which has to paint over the card and take Esc first.
        // `if`-mounted rather than permanent — this one opens once ever, so none of it exists before
        // the launch it runs on or after the click that closes it. Rust holds the unmount a beat past
        // `Onboarding.open` so the fade can play; see the global.
        if Onboarding.mounted: OnboardingOverlay {
            width: 100%;
            height: 100%;
        }

        // Declared after the main layout, so it paints above it. Always rendered so the open/close
        // animation can play; its TouchArea is `enabled` only while `Dialog.open`.
        DialogOverlay {
            width: 100%;
            height: 100%;
        }

        // After `DialogOverlay`, so a toast firing mid-dialog paints above the backdrop rather than
        // behind it. No root TouchArea, so its empty area blocks no clicks.
        NotificationStack {
            width: 100%;
            height: 100%;
        }

        // The outline an OS draws round its own frames, which a frameless window has to draw for
        // itself. Last, so nothing in the window paints over the edge, a dialog's scrim included.
        // One physical pixel at every scale, as the OS draws it.
        if root.rounded-shell && Settings.window-border-shown: EdgeOutline {
            width: 100%;
            height: 100%;
            radius: Theme.window-radius;
            stroke-width: 1phx;
            stroke-color: Theme.window-focused
                ? WindowChrome.border-color
                : WindowChrome.border-color-unfocused;
        }
    }

    // The resize grabs, live only while resizing is ours: not maximized, where it's a no-op, and not
    // under a native frame, which has its own borders. Above the overlays, so an open dialog or the
    // first-run card doesn't take resizing away, and full-size, the band being the client's edge,
    // margins and all.
    ResizeRing {
        width: 100%;
        height: 100%;
        active: root.rounded-shell;
        band: root.resize-band;
        radius: Theme.window-radius;
    }
}
