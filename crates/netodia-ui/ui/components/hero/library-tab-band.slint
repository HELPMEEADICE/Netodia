import { Theme } from "../../theme.slint";
import { HeroBackdrop } from "../../globals/hero-backdrop.slint";
import { NavEnterFrom } from "../../globals/nav.slint";
import { ArtworkImage } from "../artwork-image.slint";
import { HeroChipStrip } from "../hero-chip-strip.slint";
import { IconButton } from "../icon-button.slint";
import { MaterialIcon } from "../material-icon.slint";
import { HeroBackdropStack } from "hero-backdrop-stack.slint";
import { TabSearchHeader } from "tab-search-header.slint";

// The My Library page's pinned band, in two states. Idle it is a flat pane carrying the tab bar,
// the shared filter box and the mounted tab's count; with a detail open it **morphs** into that
// entity's hero, tabs still in it and a back button to their left.
//
// **A sibling of `MosaicTabHero`, not a fork of it** — shared header row, chip strip and blur
// backdrop; what stays here is the band's own: the morph, the palette crossing it drives, and the
// back slot it hands the row as `lead-w`. Data-agnostic, and **no string is spelled here**.
export component LibraryTabBand inherits Rectangle {
    // Inline `[@tr("…"), …]` at the host — an array populated from Rust renders untranslated.
    in property <[string]> tab-labels;
    in property <[string]> tab-icons;
    // Two-way per the orphaned-one-way-binding pitfall; the bar writes this on every pick.
    in-out property <int> tab-idx;

    in-out property <string> filter;
    in property <string> filter-placeholder;
    in property <int> blur-tick;
    // Forwarded, not decided here: whether a page's content is something to narrow is the page's
    // question.
    in property <bool> search-shown: true;

    // --- Idle ---------------------------------------------------------------
    //
    // The prominent line in place of a page title — the tabs name the page, the trade the
    // Settings page already made. Empty while the count is still the unfetched sentinel, the host
    // owning that guard: a bare `-1` interpolates into a plural as "-1 albums".
    in property <string> count-text;

    // --- Hero ---------------------------------------------------------------
    in property <bool> detail-open;
    in property <string> title;
    // Album Detail's artist, Playlist Detail's description — inside the title block rather than
    // on a row of their own, which is what leaves the band slack for a wrapped second chip row.
    in property <string> subtitle;
    in property <bool> title-badge;
    // Overlays share the morph without borrowing the retained source page's metadata.
    in property <bool> chips-shown: true;

    in property <string> artwork-path;
    in property <image> cover;
    in property <bool> circular-artwork: false;
    in property <string> fallback-icon: "music-note";
    // Genre Detail's name-hashed gradient overrides both. The defaults take the hero's own
    // `placeholder` tier, never `Theme.accent` — the tile sits *on* the hero, and only Rust knows
    // which backdrop is under it.
    in property <brush> tile-bg: HeroBackdrop.placeholder.transparentize(0.85);
    in property <brush> tile-icon-color: HeroBackdrop.placeholder;

    in property <image> blur-a;
    in property <image> blur-b;
    in property <bool> use-a;
    in property <bool> has-blur;

    callback back-clicked();
    // Fires *after* the direction and the arming below are settled, so a host handler that clears
    // its filter and calls into Rust can't be sequenced ahead of them. The bar has already
    // written `tab-idx`.
    callback tab-selected(int);
    callback search-edited(string);

    // Fires once the collapse has finished, the `Dialog.closed()` shape — **the hero's facts have
    // to outlive the detail id**, every one being a ternary over it at the host. Cancelled by a
    // re-open, so a re-drill can't land the previous hero's teardown on the new one.
    callback hero-collapsed();

    // --- The morph ----------------------------------------------------------
    //
    // **Seeded by the binding, owned by the handler** — an animated binding restarts on a dirty
    // dependency rather than on a value change, so left bound this re-bases every time a detail id
    // moves under it. The seed is what leaves mount in `NotAnimating`, so a page entered with a
    // detail already open comes up at hero height. `tab-bar.slint`'s `compact-t` is the same shape.
    property <float> hero-t: root.detail-open ? 1.0 : 0.0;
    changed detail-open => {
        self.hero-t = self.detail-open ? 1.0 : 0.0;
        collapse.running = !self.detail-open;
    }
    // **One duration, two curves.** The collapse front-loads its travel, which leaving carries
    // because the count line's alpha is biased into the morph's second half; nothing occupies the
    // entry's tail, so that curve read as a snap going in. **The duration deliberately does not
    // move with it**, the collapse `Timer` and the body's `ViewTransition` both being `dur-spatial`.
    // Spelled out rather than named, `Theme` carrying no easing; the palette transition repeats it.
    animate hero-t {
        duration: Theme.dur-spatial;
        easing: root.detail-open
            ? cubic-bezier(0.4, 0, 0.2, 1)
            : cubic-bezier(0.2, 0, 0, 1);
    }

    // Armed by the handler above rather than gated on a bool, so a re-open genuinely *cancels* it.
    // Starts idle — a page mounted with no detail never transitioned and has nothing to hand back.
    collapse := Timer {
        interval: Theme.dur-spatial;
        running: false;
        triggered => {
            self.running = false;
            root.hero-collapsed();
        }
    }

    // **Is any of the hero on screen** — one frame longer at each end than `detail-open`, and one
    // longer at the start than `hero-t > 0`; both ends were bugs.
    //
    // **What may hang off it is decided by the chip strip's change tracker, and the strip is why
    // the meta column has no `if` at all**: it watches a *layout* property the morph re-dirties
    // every frame, so dropping its branch panics. It stays mounted for the life of the band and
    // fades by **brush alpha**; only tracker-free pieces ride this.
    property <bool> hero-shown: root.detail-open || root.hero-t > 0;

    // **Is the band's own height still travelling** — the page body is the stretchy sibling under
    // it, so a morph moves the body's `y` and it may not slide on its own (`ViewTransition.slide`).
    // **`hero-t > 0` is the wrong spelling**: it is `0` on a drill-in's first frame, the one frame
    // the answer must be `true`.
    out property <bool> morphing: root.hero-t != (root.detail-open ? 1.0 : 0.0);
    out property <float> progress: root.hero-t;

    // --- The bar's palette ---------------------------------------------------
    //
    // Four brushes crossing with the pane under them: `Theme.*` tokens on the flat idle band,
    // solved `HeroBackdrop` tiers over the entity's blur. Separate brushes rather than one lerp off
    // `hero-t`, `.mix()` taking `color` operands where both sides are `brush`. **A state transition
    // rather than four `animate` blocks, the hero half arriving late off the artwork decode** —
    // only a transition anchors its start on the state change instead of re-basing on the dirt.
    property <brush> label-brush: Theme.text;
    property <brush> active-brush: Theme.accent;
    property <brush> hover-brush: Theme.surface0;
    property <brush> divider-brush: Theme.surface1;

    // The hero half, mirrored locally so a late solve *moves* rather than steps. **Each falls back
    // to its idle half while no detail is open, which is what makes the mirror safe on a *tabbed*
    // page** — `HeroBackdrop` is held across a tab leave, so bound unconditionally these settle on
    // a hero the band stopped painting. `detail-open` and not `hero-shown`: gated on the latter
    // they drain toward the token for `dur-med` *after* the collapse ends.
    property <brush> hero-label: root.detail-open ? HeroBackdrop.on-backdrop : Theme.text;
    property <brush> hero-active: root.detail-open ? HeroBackdrop.chrome : Theme.accent;
    property <brush> hero-hover:
        root.detail-open ? HeroBackdrop.on-backdrop.transparentize(0.88) : Theme.surface0;
    property <brush> hero-divider: root.detail-open ? HeroBackdrop.tile-edge : Theme.surface1;
    animate hero-label, hero-active, hero-hover, hero-divider {
        duration: Theme.dur-med;
        easing: ease-in-out;
    }

    // **Split `in` / `out` to take the morph's two curves** — the colour is the same gesture as the
    // geometry, so an `in-out` block could only be right for one direction.
    states [
        hero when root.detail-open: {
            label-brush: root.hero-label;
            active-brush: root.hero-active;
            hover-brush: root.hero-hover;
            divider-brush: root.hero-divider;
            in {
                animate label-brush, active-brush, hover-brush, divider-brush {
                    duration: Theme.dur-spatial;
                    easing: cubic-bezier(0.4, 0, 0.2, 1);
                }
            }
            out {
                animate label-brush, active-brush, hover-brush, divider-brush {
                    duration: Theme.dur-spatial;
                    easing: cubic-bezier(0.2, 0, 0, 1);
                }
            }
        }
    ]

    // --- The header width budget --------------------------------------------
    //
    // `page-w` is a **mirror** — a live `root.width` read feeding a child's size re-enters layout —
    // seeded at the header row's own **floor**, since seeded wide the bar draws full-width tabs
    // into a panel that can't seat them. The mount `Timer` is mandatory, `changed` not firing when
    // the first layout settles directly on the final value.
    property <length> page-w: 2 * Theme.pad-lg + header.row-floor;
    changed width => { self.page-w = self.width; }

    Timer {
        interval: 1ms;
        triggered => {
            root.page-w = root.width;
            self.running = false;
        }
    }

    // The back button's slot, **with its trailing gap folded into its own width** — which is what
    // lets the header row carry `spacing: 0` and the inset ease to zero. Beside a stepped gap the
    // row loses a full `pad-md` on the frame the slot unmounts, which on the way *out* is the last
    // frame, after everything else has settled: the tab bar visibly jumps left.
    property <length> back-slot-w:
        (root.pill-h + Theme.pad-sm + Theme.pad-md) * root.hero-t;

    // --- Height -------------------------------------------------------------
    //
    // The idle meta row: one `ActionPill` with `pad-xs` of air either side.
    property <length> pill-h: 32px;
    property <length> meta-row-h: root.pill-h + 2 * Theme.pad-xs;

    property <length> compact-h:
        2 * Theme.pad-lg + header.row-h + Theme.pad-md + root.meta-row-h;
    // `MosaicTabHero`'s formula unchanged, so the two bands agree on what a hero is — derived
    // rather than a literal, so growing the artwork or the bar can't leave either one cropping.
    property <length> hero-h:
        2 * Theme.pad-lg + header.row-h + Theme.pad-md + Theme.hero-artwork;

    // **Never a bound `height`** — Slint reports a root's bound dimension as both `min` and `max`,
    // so an animated one eases the *window's* own minimum. The split lets the element be drawn
    // shorter than it asked, which is what the clip is for: the hero would paint into the body.
    min-height: root.compact-h;
    preferred-height: root.compact-h + (root.hero-h - root.compact-h) * root.hero-t;
    max-height: root.hero-h;
    clip: true;
    vertical-stretch: 0;

    // Forwarded from the shared header under the names `my-library-view.slint` reads; argued in
    // `tab-search-header.slint`. Kept despite the diagonal this band caused (#45) — whether a body
    // may move is a question about the morph, which the page answers on `slide`.
    out property <NavEnterFrom> tab-enter-from <=> header.tab-enter-from;
    out property <bool> tab-anim-armed <=> header.tab-anim-armed;

    out property <length> tip-x:
        header.absolute-position.x - root.absolute-position.x + header.tip-x;
    out property <length> tip-y:
        header.absolute-position.y - root.absolute-position.y + header.tip-y;
    out property <length> tip-w <=> header.tip-w;
    out property <length> tip-h <=> header.tip-h;
    out property <string> tip-label <=> header.tip-label;
    out property <bool> tip-visible <=> header.tip-visible;

    // Behind everything else; the gradient floor shows through with no blur image, which is how
    // Genre Detail paints on the blur arm. **`detail-open` is this band's alone** — the mosaic heroes
    // never stop painting a hero, and nothing may ease *from* a tier the band wasn't painting.
    HeroBackdropStack {
        x: 0; y: 0;
        width: 100%; height: 100%;
        blur-a: root.blur-a;
        blur-b: root.blur-b;
        use-a: root.use-a;
        has-blur: root.has-blur;
        shown: root.detail-open;
    }

    // The idle pane, over the backdrop rather than instead of it. **The alpha is folded into the
    // brush**, `opacity` costing a layer on a full-bleed element animating for the whole morph.
    // `base` rather than `mantle`: nothing separates the band from the grid under it.
    idle-pane := Rectangle {
        x: 0; y: 0;
        width: 100%; height: 100%;
        background: Theme.base.with-alpha(1.0 - root.hero-t);
    }

    VerticalLayout {
        padding: Theme.pad-lg;
        spacing: Theme.pad-md;

        // The only host handing this row a leading slot, and the only one whose palette crosses —
        // hence the four mirrors and `lead-w`, which takes the back slot out of the bar's budget.
        header := TabSearchHeader {
            tab-labels: root.tab-labels;
            tab-icons: root.tab-icons;
            tab-idx <=> root.tab-idx;
            avail-w: root.page-w - 2 * Theme.pad-lg;
            lead-w: root.back-slot-w;

            filter <=> root.filter;
            filter-placeholder: root.filter-placeholder;
            blur-tick: root.blur-tick;
            search-shown: root.search-shown;

            // **All four cross from a theme token to a solved hero tier.** `active-color` matters
            // most, driving the selected label, its FILL=1 icon and the underline from one input:
            // `Theme.accent` carries no contrast floor against a blur where `chrome` clears 3:1.
            label-color: root.label-brush;
            active-color: root.active-brush;
            hover-fill: root.hover-brush;
            divider-color: root.divider-brush;

            tab-selected(i) => { root.tab-selected(i); }
            search-edited(t) => { root.search-edited(t); }

            // Opens with the morph. Clipped rather than faded on width alone, since the
            // disc is incompressible and would otherwise draw over the first tab.
            if root.hero-shown: Rectangle {
                width: root.back-slot-w;
                clip: true;
                IconButton {
                    x: 0;
                    y: (parent.height - self.height) / 2;
                    icon: "arrow_back";
                    // **The disc scales with its slot rather than sitting at full size inside it**
                    // — pinned, the clip cuts a straight edge down the middle of a circle for most
                    // of the morph. Both dimensions take the same `hero-t`.
                    icon-size: 20px * root.hero-t;
                    diameter: root.pill-h * root.hero-t;
                    // `hover-bg` must be named beside `idle-bg` — the component defaults it to an
                    // opaque `Theme.surface0`, grey over the blur the moment the pointer lands.
                    // Not `Theme.floating-chrome-bg`: wrong for a disc sitting in the tab row.
                    idle-bg: HeroBackdrop.disc-fill;
                    hover-bg: HeroBackdrop.disc-hover;
                    idle-fg: HeroBackdrop.chrome;
                    // **A bias off the morph, not the morph itself** — this is the only piece of
                    // the hero whose *size* also rides `hero-t`, so a plain alpha puts its
                    // presence at `hero-t` squared and the entry reads as a pop at the end.
                    // **Through the component's `fade`, not an `opacity` here**: `IconButton`'s
                    // root has children, so `need_layer` doesn't bail and an outside fade renders
                    // the disc to a texture re-allocated every frame against the animating clip.
                    fade: clamp(root.hero-t * 2.0, 0.0, 1.0);
                    clicked => { root.back-clicked(); }
                }
            }
        }

        HorizontalLayout {
            vertical-stretch: 1;
            spacing: Theme.pad-lg;

            if root.hero-shown: VerticalLayout {
                alignment: start;
                horizontal-stretch: 0;

                // Sized straight off `Theme.hero-artwork` rather than through an `in` property —
                // the heroes are one band, and a per-view knob is how they drifted apart before.
                ArtworkImage {
                    artwork-path: root.artwork-path;
                    cover: root.cover;
                    // **The host can't withhold `cover`, so it says so here instead** — Slint has
                    // no empty-`image` literal and Genre Detail owns none, so without this the
                    // genre hero paints whichever *other* detail is open, routine at boot.
                    has-cover: root.artwork-path != "";
                    tile-size: Theme.hero-artwork;
                    tile-radius: root.circular-artwork
                        ? Theme.hero-artwork / 2
                        : Theme.radius-lg;
                    fallback-icon: root.fallback-icon;
                    tile-bg: root.tile-bg;
                    tile-icon-color: root.tile-icon-color;
                    // **The tile fades through the component, not under an `opacity` here.** Safe
                    // on *ink* — an image fills its box — but `need_layer` bails only at exactly
                    // 1.0 and on a lone childless child, and `ArtworkImage`'s root has children,
                    // so a wrapper renders the square to a texture re-allocated every frame.
                    fade: root.hero-t;
                }
            }

            // **The one column with no `if` on it**, the chip strip at the bottom carrying the
            // change tracker nothing may drop — see the note beside `hero-shown`. In idle it is an
            // empty strip and a spacer, the rows emptied by the last collapse's teardown.
            VerticalLayout {
                horizontal-stretch: 1;
                alignment: stretch;
                spacing: Theme.pad-xs;
                // The band the floating pill row occupies, reserved rather than measured so
                // the chip strip's two-row slack is what it was when the row was a child here.
                padding-bottom: root.pill-h + Theme.pad-xs;

                // **Alpha in the brushes — here for the glyphs rather than the cost.** A layer is
                // sized to child *geometry* and a `Text`'s geometry is its line box, not its ink:
                // the patched faces reach past theirs, so a fade of this block crops Arabic marks.
                if root.hero-shown: VerticalLayout {
                    vertical-stretch: 0;
                    spacing: Theme.pad-xs;

                    HorizontalLayout {
                        vertical-stretch: 0;
                        spacing: Theme.pad-sm;
                        alignment: start;

                        // Playlist Detail's smart badge, matching the grid card's corner.
                        if root.title-badge: VerticalLayout {
                            alignment: center;
                            MaterialIcon {
                                name: "auto_awesome";
                                icon-size: 22px;
                                // Multiplied, not set: `chrome` carries its own alpha on the aurora.
                                icon-color: HeroBackdrop.chrome.transparentize(1.0 - root.hero-t);
                                filled: true;
                            }
                        }

                        Text {
                            text: "\u{200e}" + root.title;
                            color: HeroBackdrop.on-backdrop.transparentize(1.0 - root.hero-t);
                            font-size: Theme.hero-title-size;
                            font-weight: Theme.page-title-weight;
                            horizontal-alignment: left;
                            overflow: elide;
                        }
                    }

                    // **Nudged right, because the two lines share a layout edge and not an ink
                    // edge.** A glyph's left side bearing is blank built into the glyph and scales
                    // with the size drawn at, so the title's first stem sits further in than the
                    // subtitle's on most strings — 22 px SemiBold against 14 px Regular — and the
                    // smaller line reads as hanging left of the larger. The correction is optical
                    // and the exact amount is per-string, so this is a tune-by-eye number; a
                    // padding rather than an `x`, a layout child that binds one being dropped from
                    // its parent's layout info. Not the LRM, which is zero-advance in both faces.
                    if root.subtitle != "": HorizontalLayout {
                        vertical-stretch: 0;
                        padding-left: 1px;

                        Text {
                            text: "\u{200e}" + root.subtitle;
                            color: HeroBackdrop.on-backdrop.transparentize(1.0 - root.hero-t);
                            font-size: Theme.font-size-md;
                            horizontal-alignment: left;
                            overflow: elide;
                        }
                    }
                }

                // The rows live on a global six heroes share, so what empties the strip is the
                // collapse's teardown rather than an `if` — which this couldn't be anyway.
                HeroChipStrip { fade: root.hero-t; show-rows: root.chips-shown; }

                Rectangle { vertical-stretch: 1; }
            }
        }
    }

    // The idle count line. **Anchored to the *compact* band's floor, not the root's** — the whole
    // difference between it and the pill row below, which follows the current floor.
    //
    // **It does not leave the way it comes back, and `detail-open` tells the two apart**, flipping
    // on the edge where `hero-t` only knows how far along the morph is. Out is *down*, the one axis
    // with nothing arriving on it. Both directions ride `hero-t` — no second clock, and no `states`
    // entry, which animates on its *first* evaluation and would flash the count on a page mounted
    // straight into a detail. `count-t` is the alpha's bias off that clock (the `tab-bar.slint`
    // idiom), folded into the brush and never `opacity`; `count-drop` fits the slack the compact
    // floor already leaves, deliberately not `ViewTransition`'s 32 px. A bare `Text` with a bound
    // width, per the faked-placeholder pitfall — elide alone doesn't hold one in a non-layout
    // parent, and the width stops short of the pills.
    property <length> count-slide: 32px;
    property <length> count-drop: 12px;
    property <float> count-t: clamp(root.hero-t * 2.0, 0.0, 1.0);
    property <length> count-dy: root.detail-open ? root.count-drop * root.count-t : 0px;

    Text {
        x: Theme.pad-lg - (root.detail-open ? 0px : root.count-slide * root.hero-t);
        y: root.compact-h - Theme.pad-lg - root.pill-h + root.count-dy;
        width: root.page-w - 2 * Theme.pad-lg - pills.width - Theme.pad-md;
        height: root.pill-h;
        // Leading LRM keeps the line left-anchored under RTL.
        text: "\u{200e}" + root.count-text;
        color: Theme.text.with-alpha(1.0 - root.count-t);
        font-size: Theme.page-title-size;
        font-weight: Theme.page-title-weight;
        horizontal-alignment: left;
        vertical-alignment: center;
        overflow: elide;
    }

    // The action pills — the tab's, or the open detail's. **A floating slot rather than children of
    // the meta column**, Slint allowing one `@children` and the two states needing it in different
    // places; the root's lower edge is the meta row's floor in both, so no anchor is interpolated.
    // A `HorizontalLayout` rather than a bare `Rectangle`, which reports 0×0 over `if`-conditional
    // children. `pills` is a cell of its own so the count line can reserve against it.
    HorizontalLayout {
        x: Theme.pad-lg;
        y: root.height - Theme.pad-lg - root.pill-h;
        width: root.page-w - 2 * Theme.pad-lg;
        height: root.pill-h;
        alignment: end;

        pills := HorizontalLayout {
            @children
        }
    }
}
