import { ListView } from "std-widgets.slint";
import { EntityGridRow } from "../../models.slint";
import { EntityCard } from "entity-card.slint";
import { CardCell } from "card-cell.slint";

// Virtualized card grid over `EntityStripRow`, the vertical counterpart to
// `HorizontalCardStrip`. Rust chunks the flat list into rows of `columns` cards, so the inner
// `ListView` virtualizes by row.
//
// That is why a strip and a grid aren't one component: a strip walks its rows in a plain `for`,
// affordable for a capped carousel and not for an uncapped page, where every card would be built
// and every cover requested. All three grid tabs are uncapped. Covers come lazily — only a mounted
// card evaluates its binding, so the model stays pure data. Same host-mounted-scrollbar contract as
// `AlbumGrid`, so the host places its `OverlayScrollbar` flush with the content-panel edge.
export component EntityCardGrid inherits Rectangle {
    in property <[EntityGridRow]> rows;
    in property <length> card-width: 180px;
    in property <length> card-height: 226px;
    // The gap is baked into the slot height because a `ListView` lays its delegates back-to-back
    // and has no `spacing`.
    in property <length> row-height: 246px;
    in property <length> gap: 20px;
    // Circular artwork, for the artist flavour.
    in property <bool> circular: false;
    // An `ArtworkImage` placeholder key, not a Material ligature — the same vocabulary
    // `EntityCard` and `HorizontalCardStrip` take.
    in property <string> fallback-icon: "music-note";
    // Reveals the play-count badge where a row carries one; an unplayed row stays bare either way.
    in property <bool> show-play-count: false;
    // Cloud tracks carry exact string identities; local selection menus require DB ids.
    in property <bool> cloud-tracks: false;
    // **Three mounts, and they are not all the same kind of thing.** Favorites' Artists tab draws
    // artists; its Most Played tab and Recently Played's draw *tracks*. So the kind and the
    // selection scope are the host's to state rather than this component's to assume.
    //
    // **Neither carries a default, and a plausible one is what that buys.** `"track"` here would
    // send a fourth mount's album ids down the track arm, queueing whatever rows happen to hold
    // those numbers — silently right-looking. Empty reaches `EntityKind::from_token`'s `None` and
    // the warn already written for it.
    in property <string> card-kind;
    in property <string> selection-scope;

    // Bumped by the host per scheduled decode batch that lands. The card's binding *reads* it,
    // which is the only thing making a bump re-run a `pure` callback whose result is otherwise
    // cached until a dependency dirties. Its *value* decides nothing: the lookup behind it
    // always schedules a miss.
    in property <int> covers-generation: 0;

    callback row-clicked(int /*entity_id*/);
    callback cloud-row-clicked(string /*song_id*/);
    // Forwarded by the host to its own global. `pure` so a binding can call it.
    pure callback request-cover(string /*artwork_path*/, int /*generation*/) -> image;

    // Same sign convention as `TrackList` and `AlbumGrid` — a positive `v-offset` is N px
    // scrolled, where the inner `ListView` holds that as a non-positive `viewport-y`.
    out property <length> v-visible-height: list.visible-height;
    out property <length> v-viewport-height: list.viewport-height;
    out property <length> v-offset: -list.viewport-y;
    callback set-v-offset(length);
    set-v-offset(o) => { list.viewport-y = -o; }

    list := ListView {
        vertical-scrollbar-policy: always-off;
        horizontal-scrollbar-policy: always-off;
        // A card click and a drag-pan are one gesture, and the default is the style's to pick;
        // argument on the entity-card grids.
        mouse-drag-pan-enabled: false;

        for grid-row in root.rows: Rectangle {
            // A `ListView` delegate needs a fixed height or the virtualization math breaks.
            min-height: root.row-height;
            max-height: root.row-height;

            HorizontalLayout {
                padding-left: root.gap;
                padding-right: root.gap;
                spacing: root.gap;
                alignment: start;

                for entity in grid-row.entities: cell := CardCell {
                    card-width: root.card-width;
                    card-height: root.card-height;
                    scope: root.selection-scope;
                    card-kind: root.card-kind;
                    card-id: entity.id;
                    // The card's own activation, so Play over a single track card means what
                    // clicking it means. Inert on the artist mount, which never takes the arm.
                    play-single => {
                        if root.cloud-tracks { root.cloud-row-clicked(entity.remote_id); }
                        else { root.row-clicked(entity.id); }
                    }

                    card := EntityCard {
                        card-width: root.card-width;
                        card-height: root.card-height;
                        artwork-path: entity.artwork_path;
                        cover: root.request-cover(entity.artwork_path, root.covers-generation);
                        circular: root.circular;
                        fallback-icon: root.fallback-icon;
                        // A pronounced zoom on the placeholder, as on the other grids; real
                        // artwork stays gentle so a cover doesn't jitter inside the tile clip.
                        cover-scale-hover: entity.artwork_path == "" ? 1.15 : 1.04;
                        title: entity.title;
                        subtitle: entity.subtitle;
                        play-count: root.show-play-count ? entity.play_count : 0;
                        clicked => {
                            if root.cloud-tracks { root.cloud-row-clicked(entity.remote_id); }
                            else { root.row-clicked(entity.id); }
                        }

                        selectable: !root.cloud-tracks;
                        selected: cell.selected;
                        selection-live: cell.selection-live;
                        select-clicked(shift, ctrl) => { cell.pick(shift, ctrl); }
                        context-requested(x, y) => { if !root.cloud-tracks { cell.open-menu(x, y); } }
                    }

                }
            }
        }
    }
}
