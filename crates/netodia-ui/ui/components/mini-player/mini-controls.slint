import { Player } from "../../globals/player.slint";
import { MiniPlayer, WindowChrome } from "../../globals/shell.slint";
import { TooltipSide } from "../tooltip.slint";
import { MetaChip } from "../meta-chip.slint";
import { SeekRow } from "../now-playing/seek-row.slint";
import { VolumePopupHorizontal } from "../now-playing/volume-popup-horizontal.slint";
import { PlayButton } from "../now-playing/play-button.slint";
import { MiniIconButton, MiniGlyphs, MiniSizes } from "mini-icon-button.slint";

// Previous, play and next, leading the controls cluster every layout draws. Its three sizes are
// `MiniSizes`', which a card with room to spare opens up.
export component MiniTransport inherits HorizontalLayout {
    // The play disc and the glyph punched out of it, eased by the host with the rest of its surface.
    in property <brush> disc-color;
    in property <brush> disc-ink;

    spacing: 2px;
    horizontal-stretch: 0;
    alignment: center;

    VerticalLayout {
        alignment: center;
        MiniIconButton {
            icon: "chevron_left";
            diameter: MiniSizes.button-d;
            icon-size: MiniSizes.button-icon;
            button-enabled: Player.vm.has_previous;
            hold-delay: Player.scan-hold;
            repeat-interval: Player.scan-interval;
            tooltip-text: Player.previous-tooltip;
            clicked => { Player.previous(); }
            held(step) => { Player.scan-step(-1, step); }
        }
    }
    VerticalLayout {
        alignment: center;
        PlayButton {
            wrapper-d: MiniSizes.play-d;
            icon-size: MiniSizes.play-icon;
            is-playing: Player.vm.is_playing;
            is-stopped: Player.stopped-at-top;
            animation-mode: 0;
            disc-color: root.disc-color;
            icon-color: root.disc-ink;
            hold-delay: Player.stop-hold;
            clicked => { Player.play-pause(); }
            held => { Player.stop(); }
        }
    }
    VerticalLayout {
        alignment: center;
        MiniIconButton {
            icon: "chevron_right";
            diameter: MiniSizes.button-d;
            icon-size: MiniSizes.button-icon;
            button-enabled: Player.vm.has_next;
            hold-delay: Player.scan-hold;
            repeat-interval: Player.scan-interval;
            tooltip-text: Player.next-tooltip;
            clicked => { Player.next(); }
            held(step) => { Player.scan-step(1, step); }
        }
    }
}

// Volume, the pin, the backdrop switch and the heart, ending the controls cluster at the window's
// right edge.
export component MiniTrailingControls inherits HorizontalLayout {
    // How long the volume trigger takes to repaint, the host's pace.
    in property <duration> recolor;
    // The host's, the switch fading through the view's backdrop, which only the view can reach.
    callback toggle-backdrop();

    spacing: 2px;
    horizontal-stretch: 0;
    alignment: end;
    // Keeps the corner-resize TouchAreas' hit zone clear.
    padding-right: 4px;

    VerticalLayout {
        alignment: center;
        // The vertical `VolumePopup` is 180 px tall and clips against the top edge of a strip or a
        // card; the horizontal sibling is the same slider rotated, flying out to the left of the
        // disc.
        //
        // The glyph steps a size above the row's, argued at `MiniSizes`.
        VolumePopupHorizontal {
            diameter: MiniSizes.button-d;
            icon-size: MiniSizes.volume-icon;
            trigger-fg: MiniGlyphs.idle;
            trigger-hover-fg: MiniGlyphs.lit;
            trigger-hover-bg: MiniGlyphs.hover-bg;
            trigger-recolor-duration: root.recolor;
        }
    }
    // Collapsed where the window manager gives no way to keep a window on top.
    if WindowChrome.always-on-top-supported: VerticalLayout {
        alignment: center;
        MiniIconButton {
            icon: "push_pin";
            diameter: MiniSizes.button-d;
            icon-size: MiniSizes.button-icon;
            active: WindowChrome.always-on-top-active;
            filled: WindowChrome.always-on-top-active;
            tooltip-text: WindowChrome.always-on-top-active
                ? @tr("Unpin from Top") : @tr("Pin on Top");
            clicked => { WindowChrome.toggle-always-on-top(); }
        }
    }
    VerticalLayout {
        alignment: center;
        MiniIconButton {
            icon: "tonality";
            diameter: MiniSizes.button-d;
            icon-size: MiniSizes.button-icon;
            active: MiniPlayer.backdrop-shown;
            filled: MiniPlayer.backdrop-shown;
            tooltip-text: MiniPlayer.backdrop-shown
                ? @tr("Album Backdrop: on") : @tr("Album Backdrop: off");
            clicked => { root.toggle-backdrop(); }
        }
    }
    if Player.can-favorite: VerticalLayout {
        alignment: center;
        MiniIconButton {
            icon: Player.vm.track.is_favorite ? "favorite" : "favorite_border";
            diameter: MiniSizes.button-d;
            icon-size: MiniSizes.button-icon;
            active: Player.vm.track.is_favorite;
            filled: Player.vm.track.is_favorite;
            button-enabled: Player.vm.has_track;
            tooltip-text: Player.vm.track.is_favorite
                ? @tr("Unfavorite") : @tr("Favorite");
            clicked => { Player.toggle-favorite(); }
        }
    }
}

// The seek row and shared playback-mode button used by every mini-player layout.
export component MiniTimeline inherits HorizontalLayout {
    in property <brush> label-color;
    in property <brush> fill-color;
    in property <brush> track-color;
    in property <brush> seam-mask-color;
    in property <brush> chip-fill;
    in property <brush> chip-label;

    vertical-stretch: 0;
    spacing: 2px;
    // Keeps the corner-resize TouchAreas' hit zones clear at both ends.
    padding-left: 4px;
    padding-right: 4px;

    VerticalLayout {
        horizontal-stretch: 1;
        alignment: center;

        SeekRow {
            label-color: root.label-color;
            fill-color: root.fill-color;
            track-color: root.track-color;
            seam-mask-color: root.seam-mask-color;
        }
    }

    VerticalLayout {
        alignment: center;
        MiniIconButton {
            icon: Player.playback-mode-icon;
            tooltip-text: Player.playback-mode-tooltip;
            tooltip-side: TooltipSide.left;
            clicked => { Player.cycle-playback-mode(); }
        }
    }
}
