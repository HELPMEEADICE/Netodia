import { Theme } from "../../theme.slint";
import { Settings } from "../../settings.slint";
import { SettingsPage } from "../../globals/settings-page.slint";
import { SectionCard } from "../../components/settings/section-card.slint";
import { SettingRowStacked } from "../../components/settings/setting-row-stacked.slint";
import { Checkbox } from "../../components/checkbox.slint";
import { MaterialIcon } from "../../components/material-icon.slint";

// One checkbox cell, local because nothing outside this section's grid wants it.
// `toggled` fires *after* `checked` flips, so the host can pass the new value
// straight through.
component OverflowCheckCell inherits Rectangle {
    in property <string> id;
    in property <string> icon;
    in property <string> label;
    in-out property <bool> checked;
    callback toggled();

    background: touch.has-hover ? Theme.surface1 : transparent;
    border-radius: Theme.radius-sm;
    animate background { duration: 100ms; easing: ease-in-out; }

    HorizontalLayout {
        padding: Theme.pad-sm;
        spacing: Theme.pad-sm;
        alignment: stretch;

        VerticalLayout {
            alignment: center;
            Checkbox {
                checked: root.checked;
                unchecked-border: Theme.text-muted;
            }
        }
        VerticalLayout {
            alignment: center;
            MaterialIcon {
                name: root.icon;
                icon-size: 20px;
                icon-color: Theme.text;
            }
        }
        VerticalLayout {
            alignment: center;
            horizontal-stretch: 1;
            // Every mount below passes a translated literal, so no `@tr()` here.
            Text {
                text: root.label;
                color: Theme.text;
                font-size: Theme.font-size-sm;
            }
        }
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.checked = !root.checked;
            root.toggled();
        }
    }
}

// Which buttons the now-playing bar's overflow menu carries. Split from
// `appearance-section.slint` because it's a bar feature, not a palette one. Each
// cell two-way binds its flag and reports the flip for Rust to persist.
export component OverflowMenuSection inherits Rectangle {
    background: transparent;
    horizontal-stretch: 1;
    vertical-stretch: 0;

    in property <string> tab-name;

    property <string> card-title: @tr("Player Bar");

    pure function row-visible(label: string, desc: string) -> bool {
        return SettingsPage.row-visible(root.tab-name, root.card-title,
                                        label + " " + desc,
                                        SettingsPage.search-query);
    }

    property <string> overflow-label: @tr("Overflow Menu Buttons");
    property <string> overflow-desc: @tr("Move selected buttons into a compact overflow menu in the player bar");

    property <bool> show-overflow: row-visible(overflow-label, overflow-desc);

    out property <bool> has-matches: show-overflow;

    VerticalLayout {
    if has-matches: SectionCard {
        title: root.card-title;

        if root.show-overflow: SettingRowStacked {
            icon: "more_vert";
            label: root.overflow-label;
            description: root.overflow-desc;

            // A `GridLayout` rather than rows of `HorizontalLayout`s: equal
            // stretch only divides the *surplus* on top of each cell's
            // preferred width, so a row with a longer label lands wider and the
            // second column drifts between rows. A grid sizes each column to its
            // widest cell and holds that across every row.
            GridLayout {
                spacing: Theme.pad-xs;
                Row {
                    OverflowCheckCell {
                        id: "favorite";
                        icon: "favorite";
                        label: @tr("Favorite");
                        checked <=> Settings.overflow-favorite;
                        toggled => { Settings.overflow-buttons-changed(self.id, self.checked); }
                    }
                    OverflowCheckCell {
                        id: "repeat";
                        icon: "repeat";
                        label: @tr("Playback");
                        checked <=> Settings.overflow-repeat;
                        toggled => { Settings.overflow-buttons-changed(self.id, self.checked); }
                    }
                }
                Row {
                    OverflowCheckCell {
                        id: "pin";
                        icon: "push_pin";
                        label: @tr("Pin on Top");
                        checked <=> Settings.overflow-pin;
                        toggled => { Settings.overflow-buttons-changed(self.id, self.checked); }
                    }
                    OverflowCheckCell {
                        id: "queue";
                        icon: "queue_music";
                        label: @tr("Queue");
                        checked <=> Settings.overflow-queue;
                        toggled => { Settings.overflow-buttons-changed(self.id, self.checked); }
                    }
                }
                Row {
                    OverflowCheckCell {
                        id: "quality";
                        icon: "graphic_eq";
                        label: @tr("Signal Path");
                        checked <=> Settings.overflow-quality;
                        toggled => { Settings.overflow-buttons-changed(self.id, self.checked); }
                    }
                }
            }
        }
    }
    }
}
