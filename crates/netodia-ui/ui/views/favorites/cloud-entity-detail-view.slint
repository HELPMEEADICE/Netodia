import { Theme } from "../../theme.slint";
import { Favorites } from "../../globals/curated.slint";
import { CloudEntityDetail } from "../../globals/cloud-entity-detail.slint";
import { CloudTrackActions } from "../../globals/cloud-track-actions.slint";
import { Nav } from "../../globals/nav.slint";
import { ActionPill, PillButton } from "../../components/action-pill.slint";
import { LibraryTabBand } from "../../components/hero/library-tab-band.slint";
import { ViewTransition } from "../../components/view-transition.slint";
import { TooltipFrame } from "../../components/tooltip-frame.slint";
import { CloudPlaylistTracks } from "../my-library/cloud-playlist-tracks.slint";

// Online album/artist drill-ins share My Library's header morph and list reveal. Keep the source
// page mounted underneath, and retain this header until its collapse hands the source back.
export component CloudEntityDetailView inherits Rectangle {
    private property <bool> content-mounted: CloudEntityDetail.open;
    private property <bool> expanded: false;
    private property <bool> watched-open: CloudEntityDetail.open;
    // Own the latch even when returning from the miniplayer with a detail already open.
    init => {
        root.content-mounted = CloudEntityDetail.open;
        opening.running = CloudEntityDetail.open;
    }
    changed watched-open => {
        opening.running = false;
        if (root.watched-open) {
            if (root.content-mounted) {
                // Reverse an in-flight collapse and cancel the band's pending teardown.
                root.expanded = true;
            } else {
                root.expanded = false;
                root.content-mounted = true;
                opening.running = true;
                opening.restart();
            }
        } else {
            if (root.expanded) {
                root.expanded = false;
            } else {
                // Back can arrive before the opening frame's timer has fired.
                root.finish-close();
            }
        }
    }

    // This timer belongs to the retained controller and is explicitly rearmed on every open.
    // A timer inside the conditional content keeps its stopped state after the first close.
    // Wait for a compact frame before asking the shared band to expand.
    opening := Timer {
        interval: 1ms;
        running: false;
        triggered => {
            self.running = false;
            root.expanded = CloudEntityDetail.open;
        }
    }

    function finish-close() {
        if (!CloudEntityDetail.open) {
            root.content-mounted = false;
            CloudEntityDetail.closed();
        }
    }

    visible: root.content-mounted && !Nav.now-playing-open;

    // Keep the band alive with its controller. Recreating it after the opening timer fires
    // seeds its hero progress at the final value and skips the expansion on later visits.
    Rectangle {
        width: 100%;
        height: 100%;
        // The source remains mounted to preserve its scroll position. Cover it even while a
        // child fades, otherwise its header and rows flash through the arriving detail.
        background: CloudEntityDetail.open ? Theme.base : transparent;

        // Covers gaps between controls while the overlay is entering or returning.
        TouchArea { }

        VerticalLayout {
            band := LibraryTabBand {
                tab-labels: CloudEntityDetail.kind == "artist" ? [@tr("Artists")] : [@tr("Albums")];
                tab-icons: CloudEntityDetail.kind == "artist" ? ["person"] : ["album"];
                search-shown: false;
                chips-shown: false;
                detail-open: root.expanded;
                back-clicked => { CloudEntityDetail.close(); }
                hero-collapsed => { root.finish-close(); }

                // Cross-fade the outgoing header with the source header, on the band's own clock.
                opacity: CloudEntityDetail.open ? 1.0 : band.progress;
                title: CloudEntityDetail.title;
                subtitle: CloudEntityDetail.kind == "artist" ? @tr("Top songs") : CloudEntityDetail.subtitle;
                artwork-path: CloudEntityDetail.artwork-path;
                cover: Favorites.request-album-cover(
                    CloudEntityDetail.artwork-path, Favorites.album-covers-generation,
                );
                circular-artwork: CloudEntityDetail.kind == "artist";
                fallback-icon: CloudEntityDetail.kind == "artist" ? "person" : "album";

                if CloudEntityDetail.kind == "album": ActionPill {
                    PillButton {
                        icon: CloudEntityDetail.album-favorite ? "favorite" : "favorite_border";
                        icon-filled: CloudEntityDetail.album-favorite;
                        active: CloudEntityDetail.album-favorite;
                        text: CloudEntityDetail.album-favorite ? @tr("Unfavorite album") : @tr("Favorite album");
                        enabled: CloudEntityDetail.album-favorite-known && !CloudEntityDetail.album-favorite-pending;
                        clicked => {
                            Favorites.set-album-favorite(CloudEntityDetail.remote-id, !CloudEntityDetail.album-favorite);
                        }
                    }
                }
            }

            Rectangle {
                vertical-stretch: 1;
                clip: true;

                if CloudEntityDetail.open: Rectangle {
                    width: 100%;
                    height: 100%;
                    background: Theme.base;

                    VerticalLayout {
                        if CloudEntityDetail.kind == "album" && CloudEntityDetail.album-favorite-error != "": HorizontalLayout {
                            padding-left: Theme.pad-lg;
                            padding-right: Theme.pad-lg;
                            spacing: Theme.pad-md;
                            Text {
                                text: CloudEntityDetail.album-favorite-error;
                                color: Theme.subtext0;
                                wrap: word-wrap;
                                horizontal-stretch: 1;
                            }
                            ActionPill {
                                PillButton {
                                    icon: "refresh";
                                    text: @tr("Retry");
                                    enabled: !CloudEntityDetail.album-favorite-pending;
                                    clicked => { Favorites.load-album-favorite(CloudEntityDetail.remote-id); }
                                }
                            }
                        }

                        Rectangle {
                            vertical-stretch: 1;

                            // Mount the reveal with the ready list, not its loading placeholder.
                            // The band owns all vertical travel throughout its morph.
                            if !CloudEntityDetail.loading && CloudEntityDetail.error == "": ViewTransition {
                                width: 100%;
                                height: 100%;
                                slide: false;
                                replay-key: CloudEntityDetail.kind + ":" + CloudEntityDetail.remote-id;

                                CloudPlaylistTracks {
                                    width: 100%;
                                    height: 100%;
                                    rows: CloudEntityDetail.tracks;
                                    columns <=> Favorites.track-columns;
                                    sort-field: "position";
                                    sort-dir: "asc";
                                    position-field: "position";
                                    show-number: true;
                                    favorite-clickable: true;
                                    sortable: false;
                                    cloud-entity-links: true;
                                    play-track(id, index) => { CloudEntityDetail.play-cloud-row(id, index); }
                                    toggle-favorite(id, liked) => { CloudTrackActions.toggle-favorite(id, liked); }
                                }
                            }

                            if CloudEntityDetail.loading: Text {
                                x: Theme.pad-lg;
                                y: Theme.pad-lg;
                                text: @tr("Loading…");
                                color: Theme.subtext0;
                            }

                            if !CloudEntityDetail.loading && CloudEntityDetail.error != "": VerticalLayout {
                                x: Theme.pad-lg;
                                y: Theme.pad-lg;
                                width: parent.width - 2 * Theme.pad-lg;
                                spacing: Theme.pad-md;
                                Text {
                                    text: CloudEntityDetail.error;
                                    color: Theme.subtext0;
                                    wrap: word-wrap;
                                }
                                ActionPill {
                                    PillButton {
                                        icon: "refresh";
                                        text: @tr("Retry");
                                        clicked => { CloudEntityDetail.retry(); }
                                    }
                                }
                            }

                            if !CloudEntityDetail.loading && CloudEntityDetail.error == ""
                                && CloudEntityDetail.tracks.length == 0: Text {
                                x: Theme.pad-lg;
                                y: Theme.pad-lg;
                                text: @tr("No tracks available");
                                color: Theme.subtext0;
                            }
                        }
                    }
                }
            }
        }

        TooltipFrame {
            x: band.absolute-position.x - parent.absolute-position.x + band.tip-x;
            y: band.absolute-position.y - parent.absolute-position.y + band.tip-y;
            width: band.tip-w;
            height: band.tip-h;
            label: band.tip-label;
            shown: band.tip-visible;
        }
    }
}
