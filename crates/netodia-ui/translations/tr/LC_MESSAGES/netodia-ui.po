msgstr "Sistem, işletim sisteminin kendi pencere kenarlıklarını çizdiği rengi izler."

#: ui/views/settings/window-chrome-section.slint
msgid "Available only while the window border is shown."
msgstr "Yalnızca pencere kenarlığı gösterilirken kullanılabilir."

#: ui/views/settings/window-chrome-section.slint
msgid "Decoration Button Style"
msgstr "Pencere düğmeleri stili"

#: ui/views/settings/window-chrome-section.slint
msgid "Decoration Button Side"
msgstr "Pencere düğmeleri tarafı"

#: ui/views/settings/window-chrome-section.slint
msgid "System Tray Icon"
msgstr "Sistem Tepsisi Simgesi"

#: ui/views/settings/window-chrome-section.slint
msgid "Show a Netodia icon in the system tray with playback controls."
msgstr "Sistem tepsisinde oynatma denetimleriyle bir Netodia simgesi göster."

#: ui/views/settings/window-chrome-section.slint
msgid "Close to Tray"
msgstr "Sistem Tepsisine Kapat"

#: ui/views/settings/window-chrome-section.slint
msgid "Keep Netodia running in the system tray when you close the window, instead of quitting."
msgstr "Pencereyi kapattığınızda Netodia'dan çıkmak yerine sistem tepsisinde çalışır durumda tut."

#: ui/views/settings/window-chrome-section.slint
msgid "Available only while the system tray icon is active."
msgstr "Yalnızca sistem tepsisi simgesi etkinken kullanılabilir."

#: ui/views/settings/window-chrome-section.slint
msgid "Switching to the native title bar requires restarting Netodia. Restart now?"
msgstr "Yerel başlık çubuğuna geçmek Netodia'nın yeniden başlatılmasını gerektirir. Şimdi yeniden başlatılsın mı?"

#: ui/views/settings/window-chrome-section.slint
msgid "Switching to the custom title bar requires restarting Netodia. Restart now?"
msgstr "Özel başlık çubuğuna geçmek Netodia'nın yeniden başlatılmasını gerektirir. Şimdi yeniden başlatılsın mı?"

#: ui/views/settings/window-chrome-section.slint
msgid "Square"
msgstr "Kare"

#: ui/views/settings/window-chrome-section.slint
msgid "Left"
msgstr "Sol"

#: ui/views/settings/window-chrome-section.slint
msgid "Right"
msgstr "Sağ"

#: ui/views/settings/window-chrome-section.slint
msgid "Changing the system tray icon requires restarting Netodia. Restart now?"
msgstr "Sistem tepsisi simgesini değiştirmek Netodia'yı yeniden başlatmayı gerektirir. Şimdi yeniden başlatılsın mı?"

#: ui/views/my-library/tab-pills.slint
msgid "In order"
