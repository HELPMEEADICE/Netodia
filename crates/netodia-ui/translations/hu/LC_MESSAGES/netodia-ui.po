#: ui/views/settings/update-section.slint
msgid "This update fixes a critical issue and can't be skipped."
msgstr "Ez a frissítés kritikus hibát javít, ezért nem hagyható ki."

#: ui/views/settings/window-chrome-section.slint
msgid "Window"
msgstr "Ablak"

#: ui/views/settings/window-chrome-section.slint
msgid "Managed by the operating system"
msgstr "Az operációs rendszer kezeli"

#: ui/views/settings/window-chrome-section.slint
msgid "Native Title Bar"
msgstr "Natív címsor"

#: ui/views/settings/window-chrome-section.slint
msgid "Use the operating system's native title bar instead of the custom one. Restart required to apply."
msgstr "Az operációs rendszer natív címsorának használata az egyéni helyett. Az érvényesítéshez újraindítás szükséges."

#: ui/views/settings/window-chrome-section.slint
msgid "Match Unfocused Window Background"
msgstr "Igazodás az inaktív ablak hátteréhez"

#: ui/views/settings/window-chrome-section.slint
msgid "Only available with the native title bar."
msgstr "Csak natív címsorral érhető el."

#: ui/views/settings/window-chrome-section.slint
msgid "Tint the sidebar and now-playing bar toward the content background when the window loses focus."
msgstr "Az oldalsáv és a lejátszósáv színe a tartalom hátteréhez közelít, amikor az ablak elveszíti a fókuszt."

#: ui/views/settings/window-chrome-section.slint
msgid "Window Corner Radius"
msgstr "Ablaksarkok lekerekítése"

#: ui/views/settings/window-chrome-section.slint
msgid "Window Border"
msgstr "Ablakkeret"

#: ui/views/settings/window-chrome-section.slint
msgid "Draw a thin outline around the miniplayer. The full window keeps the border of its system frame."
msgstr "Vékony körvonal a minilejátszó körül. A teljes ablak megtartja a rendszer által rajzolt keretét."

#: ui/views/settings/window-chrome-section.slint
msgid "Draw a thin outline around the whole window, the miniplayer included."
msgstr "Vékony körvonal az egész ablak körül, a minilejátszót is beleértve."

#: ui/views/settings/window-chrome-section.slint
msgid "Window Border Color"
msgstr "Ablakkeret színe"

#: ui/views/settings/window-chrome-section.slint
msgid "System follows the color the operating system draws its own window borders in."
msgstr "A Rendszer beállítás azt a színt követi, amellyel az operációs rendszer a saját ablakkereteit rajzolja."

#: ui/views/settings/window-chrome-section.slint
msgid "Available only while the window border is shown."
msgstr "Csak akkor érhető el, ha az ablakkeret látható."

#: ui/views/settings/window-chrome-section.slint
msgid "Decoration Button Style"
msgstr "Ablakgombok stílusa"

#: ui/views/settings/window-chrome-section.slint
msgid "Decoration Button Side"
msgstr "Ablakgombok oldala"

#: ui/views/settings/window-chrome-section.slint
msgid "System Tray Icon"
msgstr "Rendszertálca-ikon"

#: ui/views/settings/window-chrome-section.slint
msgid "Show a Netodia icon in the system tray with playback controls."
msgstr "Netodia-ikon megjelenítése a rendszertálcán, lejátszásvezérlőkkel."

#: ui/views/settings/window-chrome-section.slint
msgid "Close to Tray"
msgstr "Bezárás a tálcára"

#: ui/views/settings/window-chrome-section.slint
msgid "Keep Netodia running in the system tray when you close the window, instead of quitting."
msgstr "Az ablak bezárásakor a Netodia kilépés helyett tovább fut a rendszertálcán."

#: ui/views/settings/window-chrome-section.slint
msgid "Available only while the system tray icon is active."
msgstr "Csak akkor érhető el, ha a rendszertálca-ikon aktív."

#: ui/views/settings/window-chrome-section.slint
msgid "Switching to the native title bar requires restarting Netodia. Restart now?"
msgstr "A natív címsorra váltáshoz újra kell indítani a Melodiát. Újraindítod most?"

#: ui/views/settings/window-chrome-section.slint
msgid "Switching to the custom title bar requires restarting Netodia. Restart now?"
msgstr "Az egyéni címsorra váltáshoz újra kell indítani a Melodiát. Újraindítod most?"

#: ui/views/settings/window-chrome-section.slint
msgid "Square"
msgstr "Szögletes"

#: ui/views/settings/window-chrome-section.slint
msgid "Left"
msgstr "Bal"

#: ui/views/settings/window-chrome-section.slint
msgid "Right"
msgstr "Jobb"

#: ui/views/settings/window-chrome-section.slint
msgid "Changing the system tray icon requires restarting Netodia. Restart now?"
msgstr "A rendszertálca-ikon módosításához újra kell indítani a Melodiát. Újraindítod most?"

#: ui/views/my-library/tab-pills.slint
msgid "In order"
msgstr "Sorrendben"
